APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Mesmo protocolo/host/porta do vhost no navegador; URLs geradas (logout, etc.) dependem disso.
APP_URL=http://conectaifpa.test

# true = coordenador pode finalizar o evento antes do fim no calendário (ex.: testar certificados). false em produção.
# EVENT_ALLOW_EARLY_FINALIZE=true

# Fuso horário da aplicação
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Com MAIL_MAILER=resend: chave em https://resend.com/api-keys
# RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Configurações do Supabase Storage
# Política esperada: apenas o bucket de imagens do evento (SUPABASE_BUCKET_EVENTS) é público
# no Supabase — as views usam /storage/v1/object/public/{bucket}/... Demais buckets são
# privados; upload e download passam sempre pelo Laravel com SUPABASE_SERVICE_ROLE_KEY.
# URL do projeto Supabase (sem barra no final)
SUPABASE_URL=
# Chave service role (somente backend)
SUPABASE_SERVICE_ROLE_KEY=
# Bucket padrão (fallback)
SUPABASE_BUCKET=
# Bucket das imagens de capa do evento (deve ser público; caminho events/{arquivo})
SUPABASE_BUCKET_EVENTS=
# Bucket para submissões iniciais de trabalhos
SUPABASE_BUCKET_WORKS=
# Bucket para versões corrigidas reenviadas pelos alunos
SUPABASE_BUCKET_CORRECTED_WORKS=corrected-works-dev
# Versão oficial final definida pela coordenação (apresentações / anais)
SUPABASE_BUCKET_OFFICIAL_WORKS=official-works-dev
# Bucket para arquivos de feedback enviados pelos avaliadores aos coordenadores
SUPABASE_BUCKET_EVALUATOR_TO_COORDINATOR=evaluator-to-coordinator-dev
# Bucket para arquivos de correções consolidadas dos coordenadores aos participantes
SUPABASE_BUCKET_COORDINATOR_TO_PARTICIPANT=coordinator-to-participant-dev
# Bucket para anexos e documentos do evento
SUPABASE_BUCKET_ATTACHMENTS=attachments-dev
# Imagens de assinatura nos certificados (backend + prévia autorizada por coord.)
SUPABASE_BUCKET_SIGNATURES=signatures-dev
# PDFs dos certificados emitidos (download só autenticado no Laravel)
SUPABASE_BUCKET_CERTIFICATES=certificates-dev

# Senha inicial para o usuário administrador/coordenador criado no seeder
ADMIN_INITIAL_PASSWORD=senha123
